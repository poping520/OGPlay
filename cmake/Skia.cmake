# The SDK ships one static archive per target. Read its consumer flags and
# linker dependencies from the manifest so they track SDK updates.
function(ogplay_import_skia)
    set(_processor "${CMAKE_SYSTEM_PROCESSOR}")
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        set(_processor "${CMAKE_OSX_ARCHITECTURES}")
    elseif(WIN32 AND CMAKE_VS_PLATFORM_NAME)
        set(_processor "${CMAKE_VS_PLATFORM_NAME}")
    endif()
    string(TOLOWER "${_processor}" _processor)
    if(_processor MATCHES "^(arm64|aarch64)$")
        set(_cpu arm64)
    elseif(_processor MATCHES "^(amd64|x86_64)$")
        set(_cpu x64)
    else()
        message(FATAL_ERROR "Skia SDK requires a single supported architecture: ${_processor}")
    endif()
    if(ANDROID AND _cpu STREQUAL "arm64")
        set(_platform android)
    elseif(WIN32 AND _cpu STREQUAL "x64")
        set(_platform windows)
    elseif(APPLE)
        set(_platform macos)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(_platform linux)
    else()
        message(FATAL_ERROR "No Skia SDK package for ${CMAKE_SYSTEM_NAME}/${_cpu}")
    endif()

    set(_sdk "${OGPLAY_SKIA_SDK_ROOT}/${_platform}-${_cpu}/release")
    set(_headers "${OGPLAY_SKIA_SDK_ROOT}/include")
    if(NOT EXISTS "${_sdk}/manifest.json" OR NOT EXISTS "${_headers}/manifest.json")
        message(FATAL_ERROR "Skia SDK missing at ${_sdk}. Initialize third_party/skia-prebuilt or set OGPLAY_SKIA_SDK_ROOT.")
    endif()
    file(READ "${_sdk}/manifest.json" _manifest)
    file(READ "${_headers}/manifest.json" _header_manifest)
    foreach(_field IN ITEMS schema_version platform target_cpu configuration skia_commit)
        string(JSON _manifest_${_field} GET "${_manifest}" "${_field}")
    endforeach()
    string(JSON _header_commit GET "${_header_manifest}" skia_commit)
    if(NOT _manifest_schema_version EQUAL 1 OR NOT _manifest_platform STREQUAL _platform OR
       NOT _manifest_target_cpu STREQUAL _cpu OR NOT _manifest_configuration STREQUAL "release" OR
       NOT _manifest_skia_commit STREQUAL _header_commit)
        message(FATAL_ERROR "Skia SDK manifests do not match ${_platform}-${_cpu}")
    endif()
    ogplay_verify_manifest_files("${_manifest}" "${_sdk}" "Skia SDK")
    ogplay_verify_manifest_files("${_header_manifest}" "${_headers}" "Skia headers")

    foreach(_field IN ITEMS link_order system_frameworks system_libraries consumer_defines)
        set(_${_field})
        string(JSON _length LENGTH "${_manifest}" "${_field}")
        if(_length GREATER 0)
            math(EXPR _last "${_length} - 1")
            foreach(_index RANGE 0 ${_last})
                string(JSON _value GET "${_manifest}" "${_field}" ${_index})
                list(APPEND _${_field} "${_value}")
            endforeach()
        endif()
    endforeach()
    set(_libraries)
    foreach(_relative IN LISTS _link_order)
        if(NOT _relative MATCHES "^lib/[a-zA-Z0-9_.-]+$" OR NOT EXISTS "${_sdk}/${_relative}")
            message(FATAL_ERROR "Invalid Skia SDK archive: ${_relative}")
        endif()
        list(APPEND _libraries "${_sdk}/${_relative}")
    endforeach()
    if(NOT _libraries)
        message(FATAL_ERROR "Skia SDK link_order is empty")
    endif()
    foreach(_framework IN LISTS _system_frameworks)
        find_library(_system_framework "${_framework}" NO_CACHE REQUIRED)
        list(APPEND _libraries "${_system_framework}")
        unset(_system_framework)
    endforeach()

    add_library(Skia::Skia INTERFACE IMPORTED GLOBAL)
    set_target_properties(Skia::Skia PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_headers}"
        INTERFACE_COMPILE_DEFINITIONS "${_consumer_defines}"
        INTERFACE_LINK_LIBRARIES "${_libraries};${_system_libraries}")
endfunction()

ogplay_import_skia()
