{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogplay.dev/schema/title-profile-v1.schema.json",
  "title": "OGPlay Title Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "runtime"],
  "properties": {
    "schema": {
      "const": 1
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "java": {
      "$ref": "#/$defs/java"
    },
    "quirks": {
      "$ref": "#/$defs/quirks"
    },
    "input": {
      "$ref": "#/$defs/input"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version_code", "so_sha256", "abi"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_code": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "so_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "abi": {
          "enum": ["armeabi", "armeabi-v7a"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_level", "lifecycle", "surface"],
      "properties": {
        "api_level": {
          "enum": [19, 22, 23]
        },
        "lifecycle": {
          "enum": ["native_activity", "gl_surface_view", "custom_jni"]
        },
        "maximum_ticks_per_call": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000
        },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          }
        },
        "native_call": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/native_call"
          }
        }
      }
    },
    "native_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "class", "method", "signature", "dispatch", "arguments"],
      "properties": {
        "phase": {
          "enum": ["startup", "resume", "frame", "pause", "shutdown", "pointer_down", "pointer_move", "pointer_up", "key_down", "key_up"]
        },
        "class": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(/[A-Za-z_$][A-Za-z0-9_$]*)+$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "signature": {
          "type": "string",
          "pattern": "^\\(.*\\).+$"
        },
        "dispatch": {
          "enum": ["instance", "static"]
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_argument"
          }
        }
      }
    },
    "native_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": ["constant", "surface_width", "surface_height", "input_x", "input_y", "input_pointer", "input_key"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guest", "source", "required"],
            "properties": {
              "guest": {
                "type": "string",
                "pattern": "^/"
              },
              "source": {
                "enum": ["apk", "obb", "external"]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "required"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cover_music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "loop"],
          "properties": {
            "source": {
              "enum": ["apk", "obb", "external"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "loop": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "method"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(/[A-Za-z_$][A-Za-z0-9_$]*)+$"
              },
              "method": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "sig", "impl", "static"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sig": {
                      "type": "string",
                      "pattern": "^\\(.*\\).+$"
                    },
                    "impl": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                    },
                    "static": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "quirks": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
