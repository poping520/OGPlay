{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogplay.dev/schema/title-profile-v4.schema.json",
  "title": "OGPlay Exact Identity Overrides v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity"
  ],
  "properties": {
    "schema": {
      "const": 4
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "quirks": {
      "$ref": "#/$defs/quirks"
    },
    "input": {
      "$ref": "#/$defs/input"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version_code": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "so_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "quirks": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "zone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_zone"
          }
        },
        "binding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_binding"
          }
        }
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "action"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "none",
            "button",
            "stick",
            "key",
            "mode"
          ]
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "press": {
          "enum": [
            "tap",
            "hold",
            "repeat"
          ]
        },
        "repeat_frames": {
          "type": "integer",
          "minimum": 2
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "settle_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "ramp_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "key": {
          "type": [
            "string",
            "integer"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "switch": {
          "enum": [
            "toggle",
            "hold"
          ]
        }
      }
    },
    "input_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "anchor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "anchor": {
          "enum": [
            "top_left",
            "top",
            "top_right",
            "left",
            "center",
            "right",
            "bottom_left",
            "bottom",
            "bottom_right"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
