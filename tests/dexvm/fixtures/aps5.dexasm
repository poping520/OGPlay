    invoke-static {}, Lfixture/Aps5;->start()V
    return-void
.end method

.method static public callback()V
.registers 1
    sget v0, Lfixture/Aps5;->exitCode:I
    if-eqz v0, :load_b
    invoke-static {v0}, Ljava/lang/System;->exit(I)V
    return-void
:load_b
    const-string v0, "b"
    invoke-static {v0}, Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V
    return-void
.end method

.method static public loadPath(Ljava/lang/String;)V
.registers 1
    invoke-static {v0}, Ljava/lang/System;->load(Ljava/lang/String;)V
    return-void
.end method

.method static public loadLibrary(Ljava/lang/String;)V
.registers 1
    invoke-static {v0}, Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V
    return-void
.end method

.method static public runtimeLoadLibrary(Ljava/lang/String;)V
.registers 2
    invoke-static {}, Ljava/lang/Runtime;->getRuntime()Ljava/lang/Runtime;
    move-result-object v0
    invoke-virtual {v0, v1}, Ljava/lang/Runtime;->loadLibrary(Ljava/lang/String;)V
