# Interpreter conformance fixture. Expected values per family are recorded
# in tests/dexvm/interpreter_tests.cpp with their AOSP mterp source
# (docs/design/dexvm/05-verification.md §2).

.class public LCounter;
.super Ljava/lang/Object;

.field static public seed:I = 7
.field public value:I

.method public constructor <init>(I)V
.registers 2
    invoke-direct {v0}, Ljava/lang/Object;-><init>()V
    iput v1, v0, LCounter;->value:I
    return-void
.end method

.method public increment()V
.registers 2
    iget v0, v1, LCounter;->value:I
    add-int/lit8 v0, v0, 1
    iput v0, v1, LCounter;->value:I
    return-void
.end method

.method public get()I
.registers 2
    iget v0, v1, LCounter;->value:I
    return v0
.end method

# Virtual dispatch: subclass overrides describe().
.method public describe()I
.registers 2
    const/16 v0, 100
    return v0
.end method

