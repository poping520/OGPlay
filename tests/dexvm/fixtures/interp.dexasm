# Custom exception subclass thrown and caught across frames.
.class public LMyError;
.super Ljava/lang/Exception;

.method public constructor <init>(Ljava/lang/String;)V
.registers 2
    invoke-direct {v0, v1}, Ljava/lang/Exception;-><init>(Ljava/lang/String;)V
    return-void
.end method

.class public LThrower;
.super Ljava/lang/Object;

.method static public fail()V
.registers 2
    new-instance v0, LMyError;
    const-string v1, "boom"
    invoke-direct {v0, v1}, LMyError;-><init>(Ljava/lang/String;)V
    throw v0
.end method

.method static public catchAcrossFrames()I
.registers 3
    :try_start
    invoke-static {}, LThrower;->fail()V
    :try_end
    const/4 v0, 0
    return v0
    :handler
    move-exception v1
    invoke-virtual {v1}, Ljava/lang/Throwable;->getMessage()Ljava/lang/String;
    move-result-object v2
    invoke-virtual {v2}, Ljava/lang/String;->length()I
    move-result v0
    :cleanup
    return v0
    .catch Ljava/lang/Exception; :try_start :try_end :handler
.end method

.method static public uncaught()I
.registers 1
    invoke-static {}, LThrower;->fail()V
    const/4 v0, 0
    return v0
.end method

