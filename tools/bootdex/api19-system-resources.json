{
  "api_level": 19,
  "framework": {
    "jar": "framework.jar"
  },
  "resources": [
    {
      "name": "db_default_journal_mode",
      "type": "string",
      "aosp_default": "PERSIST",
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getDefaultJournalMode()Ljava/lang/String;"
      },
      "override": {
        "value": "DELETE",
        "reason": "Preserve OGPlay rollback-journal configuration; PERSIST requires separate transaction, reopen and journal-recovery validation. WAL remains unsupported."
      }
    },
    {
      "name": "db_default_sync_mode",
      "type": "string",
      "aosp_default": "FULL",
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getDefaultSyncMode()Ljava/lang/String;"
      }
    },
    {
      "name": "db_wal_sync_mode",
      "type": "string",
      "aosp_default": "FULL",
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getWALSyncMode()Ljava/lang/String;"
      }
    },
    {
      "name": "db_connection_pool_size",
      "type": "integer",
      "aosp_default": 4,
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getWALConnectionPoolSize()I"
      }
    },
    {
      "name": "db_journal_size_limit",
      "type": "integer",
      "aosp_default": 524288,
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getJournalSizeLimit()I"
      }
    },
    {
      "name": "db_wal_autocheckpoint",
      "type": "integer",
      "aosp_default": 100,
      "consumer": {
        "class": "Landroid/database/sqlite/SQLiteGlobal;",
        "method": "getWALAutoCheckpoint()I"
      }
    },
    {
      "name": "config_cursorWindowSize",
      "type": "integer",
      "aosp_default": 2048,
      "consumer": {
        "class": "Landroid/database/CursorWindow;",
        "method": "<clinit>()V"
      }
    }
  ]
}
